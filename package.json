{
  "name": "kadabook",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/noto-sans-tamil": "^0.4.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.21.0",
    "@react-navigation/native": "^7.5.1",
    "@react-navigation/native-stack": "^7.21.0",
    "expo": "~58.0.21",
    "expo-bluetooth-thermal-printer": "^1.0.1",
    "expo-crypto": "~58.0.7",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-linear-gradient": "~58.0.3",
    "expo-print": "~58.0.8",
    "expo-secure-store": "~58.0.2",
    "expo-sharing": "~58.0.21",
    "expo-status-bar": "~58.0.4",
    "expo-updates": "~58.0.19",
    "firebase": "^13.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "babel-preset-expo": "^58.0.22",
    "firebase-tools": "^15.34.2",
    "patch-package": "^8.0.1",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "start:phone": "expo start -c --lan",
    "start:tunnel": "expo start -c --tunnel",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "postinstall": "patch-package",
    "typecheck": "tsc --noEmit",
    "deploy:rules": "npx firebase deploy --only firestore:rules",
    "deploy:admin": "npm run build --prefix admin-panel && npx firebase deploy --only hosting",
    "deploy:backend": "npm run build --prefix admin-panel && npx firebase deploy --only firestore:rules,hosting",
    "firebase:login": "npx firebase login",
    "sync:eas-env": "powershell -ExecutionPolicy Bypass -File ./scripts/Push-EasFirebaseEnv.ps1",
    "build": "eas build -p android --profile preview",
    "build:android": "eas build -p android --profile preview",
    "build:apk": "eas build -p android --profile preview",
    "build:ios": "eas build -p ios --profile preview",
    "build:ios:sim": "eas build -p ios --profile ios-simulator",
    "update:preview": "eas update --channel preview --message",
    "update:prod": "eas update --channel production --message"
  },
  "private": true
}
