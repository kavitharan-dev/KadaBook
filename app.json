{
  "expo": {
    "name": "KadaBook",
    "slug": "kadabook",
    "backgroundColor": "#E8F1FF",
    "version": "1.1.3",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/5b5ed363-6013-43e8-b7a4-781000db2d75"
    },
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#E8F1FF"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kadabook.shop",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Allow KadaBook to use the camera to scan product barcodes."
      }
    },
    "android": {
      "package": "com.kadabook.shop",
      "versionCode": 18,
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.VIBRATE",
        "android.permission.CAMERA",
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-sharing",
      "expo-updates",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow KadaBook to use the camera to scan product barcodes.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow KadaBook to access your photos to set a profile picture."
        }
      ]
    ],
    "extra": {
      "buildTag": "apk-v18-full-system",
      "eas": {
        "projectId": "5b5ed363-6013-43e8-b7a4-781000db2d75"
      }
    },
    "owner": "tharan0813"
  }
}
