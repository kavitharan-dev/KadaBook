rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function adminDoc() {
      return get(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && adminDoc().data.active != false;
    }

    function isSuperAdmin() {
      return isAdmin() && adminDoc().data.role == 'super_admin';
    }

    function shopStatus(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data.status;
    }

    function graceDaysConfig() {
      return exists(/databases/$(database)/documents/appConfig/main)
        && 'graceDays' in get(/databases/$(database)/documents/appConfig/main).data
        ? int(get(/databases/$(database)/documents/appConfig/main).data.graceDays)
        : 7;
    }

    function subscriptionDoc(uid) {
      return get(/databases/$(database)/documents/subscriptions/$(uid)).data;
    }

    function expiresAtMillis(uid) {
      return exists(/databases/$(database)/documents/subscriptions/$(uid))
        ? (
            subscriptionDoc(uid).expiresAt is timestamp
              ? subscriptionDoc(uid).expiresAt.toMillis()
              : int(subscriptionDoc(uid).expiresAt)
          )
        : 0;
    }

    function effectiveShopStatus(uid) {
      let stored = shopStatus(uid);
      return stored in ['pending', 'rejected', 'suspended']
        ? stored
        : !exists(/databases/$(database)/documents/subscriptions/$(uid))
          ? (stored == 'trial' ? 'trial' : 'expired')
          : request.time.toMillis() <= expiresAtMillis(uid)
            ? (
                subscriptionDoc(uid).status == 'trial' || subscriptionDoc(uid).plan == 'trial'
                  ? 'trial'
                  : 'active'
              )
            : request.time.toMillis() <= expiresAtMillis(uid) + graceDaysConfig() * 86400000
              ? 'grace'
              : 'expired';
    }

    function defaultFeature(status, feature) {
      return (
          (status == 'trial' || status == 'active' || status == 'grace')
          && ['addSale', 'addExpense', 'manageProducts', 'viewReports', 'exportData', 'useApp', 'editProfile'].hasAny([feature])
        )
        || (status == 'expired' && ['viewReports', 'exportData', 'editProfile', 'useApp'].hasAny([feature]))
        || (status == 'pending' && feature == 'editProfile');
    }

    function matrixFeature(status, feature) {
      return !exists(/databases/$(database)/documents/appConfig/access)
        ? defaultFeature(status, feature)
        : (
            !('matrix' in get(/databases/$(database)/documents/appConfig/access).data)
              ? defaultFeature(status, feature)
              : get(/databases/$(database)/documents/appConfig/access).data.matrix.get(status, {}).get(feature, defaultFeature(status, feature)) == true
          );
    }

    function shopCanFeature(uid, feature) {
      let user = get(/databases/$(database)/documents/users/$(uid)).data;
      return ('overrides' in user && user.overrides.keys().hasAny([feature]))
        ? user.overrides[feature] == true
        : matrixFeature(effectiveShopStatus(uid), feature);
    }

    function shopCanWriteBooks(uid) {
      return shopCanFeature(uid, 'addSale');
    }

    function memberDoc(uid) {
      return get(/databases/$(database)/documents/users/$(uid)/members/$(request.auth.uid));
    }

    function isShopMember(uid) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(uid)/members/$(request.auth.uid))
        && memberDoc(uid).data.active != false;
    }

    function isShopOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    /** Owner account, or an active staff login for this shop. */
    function isShopActor(uid) {
      return isShopOwner(uid) || isShopMember(uid);
    }

    function isShopManager(uid) {
      return isShopMember(uid) && memberDoc(uid).data.role == 'manager';
    }

    /**
     * Role template plus the owner's ticks. Keep the two lists in step with src/lib/roles.ts.
     * 'editSale' also covers deleting bills.
     */
    function staffPerm(uid, perm) {
      let member = memberDoc(uid).data;
      let cashier = ['addSale', 'collectCredit', 'closeDay'];
      let manager = ['addSale', 'collectCredit', 'closeDay', 'editSale', 'addExpense', 'manageProducts', 'manageStock', 'viewReports'];
      let base = member.role == 'manager' ? perm in manager : perm in cashier;
      return member.get('permissions', {}).get(perm, base) == true;
    }

    /** The owner can do everything; staff need the permission. */
    function actorCan(uid, perm) {
      return isShopOwner(uid) || (isShopMember(uid) && staffPerm(uid, perm));
    }

    /** Branch a staff login is tied to. 'all' (or none, for older logins) means any branch. */
    function memberBranch(uid) {
      return memberDoc(uid).data.get('branchId', 'all');
    }

    function branchAllowed(uid, branchId) {
      return isShopOwner(uid) || memberBranch(uid) == 'all' || memberBranch(uid) == branchId;
    }

    /** May this login read a row of that branch? Staff tied to one branch see only theirs. */
    function canReadBranch(uid, branchId) {
      return isShopOwner(uid) || (isShopMember(uid) && (memberBranch(uid) == 'all' || memberBranch(uid) == branchId));
    }

    /** Owner only, once: stamping the main branch on a row from before branches. */
    function stampingBranch() {
      return !('branchId' in resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['branchId']);
    }

    /** Staff writes to the shop profile: invoice counter and the shop-wide day marks only. */
    function staffProfileWrite(uid) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let openingDiff = request.resource.data.get('openingBalances', {}).diff(resource.data.get('openingBalances', {}));
      return changed.hasOnly(['nextInvoice', 'openingBalances', 'closedDays'])
        && (!changed.hasAny(['nextInvoice']) || (staffPerm(uid, 'addSale') && request.resource.data.nextInvoice is number))
        && (!changed.hasAny(['closedDays']) || (staffPerm(uid, 'closeDay') && memberBranch(uid) == 'all'))
        // Add a day's opening balance, never change a saved one.
        && (!changed.hasAny(['openingBalances']) || memberBranch(uid) == 'all')
        && openingDiff.changedKeys().size() == 0
        && openingDiff.removedKeys().size() == 0;
    }

    // ── Admin-only collections ──
    match /admins/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isSuperAdmin());
      allow create, update: if isSuperAdmin();
      allow delete: if false;
    }

    match /auditLogs/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    match /payments/{id} {
      allow read, write: if isAdmin();
    }

    match /subscriptions/{uid} {
      // Owner + active staff of this shop (cashier/manager share the shop subscription).
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == uid) || isShopMember(uid);
      allow write: if isAdmin();
    }

    match /plans/{id} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    match /announcements/{id} {
      allow read: if isSignedIn();
      allow create, delete: if isSuperAdmin();
      allow update: if isSuperAdmin()
        || (isSignedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewCount']))
        || (isSignedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['dismissCount']));
    }

    match /tickets/{id} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if isAdmin()
        || (isSignedIn() && resource.data.uid == request.auth.uid && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status']));
      allow delete: if false;
    }

    match /appConfig/{docId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    // Remote config for OTA feature flags, banners, and maintenance.
    // Edit this document in the Firebase console (client writes are denied).
    match /config/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /users/{uid} {
      // Owner account, or active staff linked to this shop (opening / day-close live on this doc).
      allow read: if isAdmin() || isShopActor(uid);

      allow create: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasAll(['shopName'])
        && (!('status' in request.resource.data) || request.resource.data.status == 'pending');

      // Owner may change shop profile (not status/overrides). Staff may only write the invoice counter and day marks.
      allow update: if isAdmin()
        || (isShopOwner(uid)
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'rejectReason', 'overrides', 'overrideReason']))
        || (isShopMember(uid) && staffProfileWrite(uid));

      allow delete: if false;

      match /seen/{announcementId} {
        allow read, write: if isShopActor(uid);
      }

      // One branch on one day: its opening balance and close mark (document id `${branchId}_${day}`).
      match /branchDays/{dayId} {
        allow read: if canReadBranch(uid, resource.data.branchId);
        allow delete: if false;
        allow create: if isShopActor(uid)
          && dayId == request.resource.data.branchId + '_' + request.resource.data.day
          && branchAllowed(uid, request.resource.data.branchId)
          && request.resource.data.keys().hasOnly(['branchId', 'day', 'opening', 'closedAt'])
          && (!('opening' in request.resource.data) || request.resource.data.opening is number)
          && (!('closedAt' in request.resource.data) || actorCan(uid, 'closeDay'));
        allow update: if isShopActor(uid)
          && branchAllowed(uid, resource.data.branchId)
          && request.resource.data.branchId == resource.data.branchId
          && request.resource.data.day == resource.data.day
          && request.resource.data.keys().hasOnly(['branchId', 'day', 'opening', 'closedAt'])
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['closedAt']) || actorCan(uid, 'closeDay'))
          && (!('opening' in request.resource.data) || request.resource.data.opening is number)
          // Staff may add the day's opening balance; only the owner may change a saved one.
          && (isShopOwner(uid)
            || !('opening' in resource.data)
            || request.resource.data.get('opening', null) == resource.data.opening);
      }

      match /sales/{saleId} {
        allow read: if canReadBranch(uid, resource.data.get('branchId', ''));
        allow delete: if actorCan(uid, 'editSale');
        allow create: if actorCan(uid, 'addSale')
          && shopCanFeature(uid, 'addSale')
          && request.resource.data.amount is number
          && request.resource.data.amount > 0
          && request.resource.data.amount < 100000000
          && request.resource.data.createdAt is timestamp
          // A sale belongs to the staff member's own branch, and only they can sign it.
          && branchAllowed(uid, request.resource.data.get('branchId', ''))
          && (!('soldByUid' in request.resource.data) || request.resource.data.soldByUid == request.auth.uid);
        // Edit note, customer or date; or mark a credit bill settled. Amounts, branch and cashier never change.
        allow update: if (actorCan(uid, 'editSale')
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['note', 'customerName', 'customerPhone', 'paymentMode', 'createdAt', 'editedAt'])
            && request.resource.data.createdAt is timestamp)
          || (actorCan(uid, 'collectCredit')
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['settled']))
          || (isShopOwner(uid) && stampingBranch());
      }

      match /expenses/{expenseId} {
        allow read: if canReadBranch(uid, resource.data.get('branchId', ''));
        allow delete: if actorCan(uid, 'addExpense');
        allow create: if actorCan(uid, 'addExpense')
          && branchAllowed(uid, request.resource.data.get('branchId', ''))
          && shopCanFeature(uid, 'addExpense')
          && request.resource.data.amount is number
          && request.resource.data.amount > 0
          && request.resource.data.category is string
          && request.resource.data.category.size() > 0
          && request.resource.data.category.size() < 80
          && request.resource.data.createdAt is timestamp;
        allow update: if isShopOwner(uid) && stampingBranch();
      }

      match /products/{productId} {
        allow read: if isShopActor(uid);
        allow delete: if actorCan(uid, 'manageProducts');
        allow create: if actorCan(uid, 'manageProducts')
          && shopCanFeature(uid, 'manageProducts')
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() < 120
          && request.resource.data.sellingPrice is number
          && request.resource.data.sellingPrice >= 0
          && request.resource.data.sellingPrice < 100000000;
        allow update: if (actorCan(uid, 'manageProducts')
            && shopCanFeature(uid, 'manageProducts')
            && request.resource.data.name is string
            && request.resource.data.name.size() > 0
            && request.resource.data.name.size() < 120
            && request.resource.data.sellingPrice is number
            && request.resource.data.sellingPrice >= 0
            && request.resource.data.sellingPrice < 100000000)
          // Selling or returning a bill changes the stock count and nothing else.
          || ((actorCan(uid, 'addSale') || actorCan(uid, 'editSale'))
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock'])
            && request.resource.data.stock is number
            && request.resource.data.stock >= 0);
      }

      match /savedOrders/{orderId} {
        allow read, delete: if canReadBranch(uid, resource.data.get('branchId', ''));
        allow create: if actorCan(uid, 'addSale')
          && branchAllowed(uid, request.resource.data.get('branchId', ''))
          && shopCanFeature(uid, 'addSale')
          && request.resource.data.savedAt is timestamp
          && request.resource.data.total is number
          && request.resource.data.total > 0;
        allow update: if isShopOwner(uid) && stampingBranch();
      }

      // Staff membership for this shop (owner manages; all shop actors can list for sync).
      // A switched-off login may still read its own row, so the app can sign it out.
      match /members/{memberId} {
        allow read: if isShopOwner(uid)
          || (isSignedIn() && request.auth.uid == memberId)
          || (isShopMember(uid) && memberBranch(uid) == 'all');
        allow create, update: if isShopOwner(uid);
        allow delete: if isShopOwner(uid);
      }

      // Kitchen & Stock (branches, raw materials, recipes, stock ledger).
      // Owner + manager can manage stock; cashiers may write sale usage only.
      match /branches/{branchId} {
        allow read: if isShopActor(uid);
        allow delete: if isShopOwner(uid);
        allow create, update: if isShopOwner(uid)
          && shopCanFeature(uid, 'manageProducts')
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 40;
      }

      match /materials/{materialId} {
        allow read: if isShopActor(uid);
        allow delete: if actorCan(uid, 'manageStock');
        allow create, update: if actorCan(uid, 'manageStock')
          && shopCanFeature(uid, 'manageProducts')
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 60;
      }

      match /recipes/{recipeId} {
        allow read: if isShopActor(uid);
        allow delete: if actorCan(uid, 'manageStock');
        allow create, update: if actorCan(uid, 'manageStock')
          && shopCanFeature(uid, 'manageProducts');
      }

      // One item at one branch. Changes in the same transaction as its ledger movement.
      match /stock/{rowId} {
        // A sale's transaction also reads rows that do not exist yet (first sale before a delivery).
        allow get: if isShopActor(uid) && (resource == null || canReadBranch(uid, resource.data.branchId));
        allow list: if canReadBranch(uid, resource.data.branchId);
        // Owner/manager may clear rows when reloading the kitchen catalog (Mr Chef list).
        allow delete: if actorCan(uid, 'manageStock');
        allow create: if rowId == request.resource.data.branchId + '_' + request.resource.data.itemId
          && request.resource.data.keys().hasOnly(['branchId', 'itemId', 'qty', 'avgCost'])
          && request.resource.data.qty is number
          && request.resource.data.avgCost is number
          && branchAllowed(uid, request.resource.data.branchId)
          && (actorCan(uid, 'manageStock')
            // A sale before the first delivery starts the row below zero; a return can start it above.
            || (actorCan(uid, 'addSale') && request.resource.data.qty < 0 && request.resource.data.avgCost == 0)
            || (actorCan(uid, 'editSale') && request.resource.data.avgCost == 0));
        allow update: if request.resource.data.branchId == resource.data.branchId
          && request.resource.data.itemId == resource.data.itemId
          && request.resource.data.keys().hasOnly(['branchId', 'itemId', 'qty', 'avgCost'])
          && request.resource.data.qty is number
          && branchAllowed(uid, resource.data.branchId)
          && (actorCan(uid, 'manageStock')
            // Selling only takes stock away, and a returned bill only puts it back.
            || (actorCan(uid, 'addSale')
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['qty'])
              && request.resource.data.qty < resource.data.qty)
            || (actorCan(uid, 'editSale')
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['qty'])
              && request.resource.data.qty > resource.data.qty));
      }

      // The stock ledger: append only. A correction is a new movement (a count), never an edit.
      match /stockMoves/{moveId} {
        allow read: if canReadBranch(uid, resource.data.branchId);
        allow update, delete: if false;
        allow create: if branchAllowed(uid, request.resource.data.get('branchId', ''))
          && (
            (actorCan(uid, 'manageStock') && shopCanFeature(uid, 'manageProducts'))
            || (actorCan(uid, 'addSale') && shopCanFeature(uid, 'addSale') && request.resource.data.type == 'sale')
            || (actorCan(uid, 'editSale') && request.resource.data.type == 'saleReturn')
          );
      }

      // Kitchen / shop supplier payables.
      match /suppliers/{supplierId} {
        allow read: if isShopActor(uid);
        allow delete: if actorCan(uid, 'manageStock');
        allow create, update: if actorCan(uid, 'manageStock')
          && shopCanFeature(uid, 'manageProducts')
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 60
          && request.resource.data.payable is number
          && request.resource.data.payable >= 0
          && request.resource.data.payable < 100000000;
      }

      match /customers/{customerId} {
        allow read: if isShopActor(uid);
        allow create, update: if (actorCan(uid, 'addSale') || actorCan(uid, 'collectCredit')) && shopCanFeature(uid, 'addSale');
        allow delete: if isShopOwner(uid) || isShopManager(uid);
      }

      match /creditPayments/{paymentId} {
        allow read: if canReadBranch(uid, resource.data.get('branchId', ''));
        allow create: if actorCan(uid, 'collectCredit')
          && branchAllowed(uid, request.resource.data.get('branchId', ''))
          && shopCanFeature(uid, 'addSale');
        allow update, delete: if isShopOwner(uid) || isShopManager(uid);
      }

      match /returns/{returnId} {
        allow read: if canReadBranch(uid, resource.data.get('branchId', ''));
        allow create: if actorCan(uid, 'editSale')
          && branchAllowed(uid, request.resource.data.get('branchId', ''))
          && shopCanFeature(uid, 'addSale');
        allow update, delete: if isShopOwner(uid) || isShopManager(uid);
      }

      match /audit/{entryId} {
        allow read: if isShopOwner(uid) || (isShopManager(uid) && memberBranch(uid) == 'all');
        allow create: if isShopActor(uid);
        allow update, delete: if false;
      }
    }

    match /staffIndex/{staffUid} {
      allow read: if isSignedIn() && (request.auth.uid == staffUid || isAdmin());
      allow create, update: if isSignedIn();
      allow delete: if isAdmin() || isSignedIn();
    }
  }
}
